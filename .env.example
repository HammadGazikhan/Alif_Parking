# ---------------------------------------------------------------------------
# Alif Parking Management Portal - environment configuration
# Copy to `.env` and fill in values. Never commit real secrets.
# All variables below are read on the server only.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alif_parking?schema=public"

# Public base URL of the app (used for links in notifications/receipts)
APP_URL="http://localhost:3000"

# Auth.js - generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Microsoft Entra ID (Azure AD) single sign-on - the only way to sign in.
# 1. Entra admin center -> App registrations -> New registration
#    - Supported account types: "Accounts in this organizational directory only"
#    - Redirect URI (Web): {AUTH_URL}/api/auth/callback/microsoft-entra-id
#      e.g. http://localhost:3000/api/auth/callback/microsoft-entra-id
# 2. Certificates & secrets -> New client secret -> copy the secret *value*
# 3. API permissions -> Microsoft Graph:
#    - Delegated:   openid, profile, email, User.Read   (sign-in)
#    - Application: User.Read.All                       (Add employee directory picker)
#    then click "Grant admin consent".
# The issuer MUST contain your Directory (tenant) ID - "common"/"organizations"
# are rejected so that only accounts from your tenant can sign in.
AUTH_MICROSOFT_ENTRA_ID_ID="<application-client-id>"
AUTH_MICROSOFT_ENTRA_ID_SECRET="<client-secret-value>"
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<directory-tenant-id>/v2.0"

# Comma-separated work emails that are always administrators. They are created
# automatically on first Microsoft sign-in (everyone else must be added by an admin).
BOOTSTRAP_ADMIN_EMAILS="hammad.g@alifconsulting.com"

# Payment provider: "mock" (local development) or "razorpay"
PAYMENT_PROVIDER="razorpay"

# Razorpay (required when PAYMENT_PROVIDER=razorpay)
# Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_live_Tni8uHL568H5at"
RAZORPAY_KEY_SECRET="ryvM28dk08QCoAy8MXatp1tU"
# Dashboard -> Settings -> Webhooks. Point it to {APP_URL}/api/payments/webhook
# and subscribe to: qr_code.credited, payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET="2848a799bbb315c4458068883fc006675d9a4f9cbbbbcdc7db8964b4aeff89ee"

# Mock gateway webhook signing secret (development only)
MOCK_WEBHOOK_SECRET="2848a799bbb315c4458068883fc006675d9a4f9cbbbbcdc7db8964b4aeff89ee"

# UPI payee details rendered into the mock QR / deep link
UPI_VPA="alifparking@upi"
UPI_PAYEE_NAME="Alif Cloud Consulting"

# Shared secret for scheduled jobs (e.g. marking fees overdue)
# Call: POST /api/cron/overdue with header `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET="replace-with-a-long-random-string"
